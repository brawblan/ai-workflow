 """Text helpers."""
 
 import re
+
+
+def slugify(title: str) -> str:
+    """Return a URL slug: lower case words of a-z and 0-9, joined by '-'."""
+    words = re.findall(r"[a-z0-9]+", title.lower())
+    return "-".join(words)
