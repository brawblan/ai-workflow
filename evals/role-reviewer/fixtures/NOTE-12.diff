diff --git a/src/notes.py b/src/notes.py
index 9319829..f259af3 100644
--- a/src/notes.py
+++ b/src/notes.py
@@ -12,3 +12,11 @@ class Notes:
 
     def list(self) -> list[str]:
         return [f"{n}. {text}" for n, text in enumerate(self.items, start=1)]
+
+    def count(self) -> int:
+        """Return the number of notes."""
+        return len(self.items)
+
+    def clear(self) -> None:
+        """Remove all notes."""
+        self.items.clear()
diff --git a/tests/test_notes.py b/tests/test_notes.py
index 6130efb..1743597 100644
--- a/tests/test_notes.py
+++ b/tests/test_notes.py
@@ -14,3 +14,16 @@ class NotesTest(unittest.TestCase):
         notes.add("a")
         notes.add("b")
         self.assertEqual(notes.list(), ["1. a", "2. b"])
+
+    def test_count(self) -> None:
+        notes = Notes()
+        self.assertEqual(notes.count(), 0)
+        notes.add("a")
+        notes.add("b")
+        self.assertEqual(notes.count(), 2)
+
+    def test_clear(self) -> None:
+        notes = Notes()
+        notes.add("a")
+        notes.clear()
+        self.assertEqual(notes.list(), [])
