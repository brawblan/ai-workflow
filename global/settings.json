{
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Pop.aiff"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "workflow@brawblan": true
  },
  "extraKnownMarketplaces": {
    "brawblan": {
      "source": {
        "source": "github",
        "repo": "brawblan/ai-workflow"
      }
    }
  },
  "effortLevel": "high",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  }
}
